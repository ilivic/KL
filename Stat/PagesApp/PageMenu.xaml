<Page x:Class="Stat.PagesApp.PageMenu"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Stat.PagesApp"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PageMenu">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="8*"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
            <StackPanel>
                <Image Source="{Binding Photo}" Width="150" Height="150"/>
                <Label Content="{Binding Name}" MouseDown="Label_MouseDown"/>
            </StackPanel>
            <Button Content="Прочитать" Click="Button_Click"/>
            <Button Content="добавить" x:Name="btnCreate" Click="btnCreate_Click"/>
            <Button Content="мои отзывы" Click="Button_Click_1"/>
        </StackPanel>
        <Frame Grid.Column="1" x:Name="SapFrame" NavigationUIVisibility="Hidden"/>
    </Grid>
</Page>
