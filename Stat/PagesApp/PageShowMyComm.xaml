<Page x:Class="Stat.PagesApp.PageShowMyComm"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Stat.PagesApp"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PageShowMyComm">

    <Grid>
        <ScrollViewer>
            <StackPanel>
                <ListView x:Name="ListComm">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding Users.Photo}" Width="50" Height="50"/>
                                <StackPanel>

                                    <Label Content="{Binding Title}"/>
                                    <TextBlock Text="{Binding Body}"/>
                                </StackPanel>
                                <Button Content="Подробнее" Click="Button_Click"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
