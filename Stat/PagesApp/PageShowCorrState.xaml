<Page x:Class="Stat.PagesApp.PageShowCorrState"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Stat.PagesApp"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PageShowCorrState">

    <Grid>
        <ScrollViewer>
            
        <StackPanel>
            <Image Source="{Binding image}" Width="250" Height="250"/>
            <Label Content="{Binding Title}"/>
            <TextBlock TextWrapping="Wrap" Text="{Binding Body}"/>
                <StackPanel>
                    <Label Content="отзывы"/>
                    <ListView x:Name="ListComm">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding Users.Photo}" Width="50" Height="50"/>
                                    <StackPanel>
                                        
                                    <Label Content="{Binding Title}"/>
                                    <TextBlock Text="{Binding Body}"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
                <StackPanel>
                    <TextBox x:Name="TxtComment"/>
                    <Button Content="Отправить" Click="Button_Click"/>
                </StackPanel>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
