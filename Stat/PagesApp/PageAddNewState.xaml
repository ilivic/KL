<Page x:Class="Stat.PagesApp.PageAddNewState"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Stat.PagesApp"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PageAddNewState">

    <Grid>
        <StackPanel>
            <Label Content="Заголовок"/>
            <TextBox x:Name="TxtTitle"/>
            <Label Content="текст"/>
            <TextBox x:Name="TxtBody" TextWrapping="Wrap"/>
            <StackPanel>
                <Label Content="изображение"/>
                <Button Content="Добавить изображение" Click="Button_Click"/>
            </StackPanel>
            <StackPanel>
                <Label Content="Файл"/>
                <Button Content="Добавить файл" Click="Button_Click_2"/>
            </StackPanel>
            <Button Content="опубликовать" Click="Button_Click_1"/>
        </StackPanel>
    </Grid>
</Page>
